We-bsite



css


body { font-family: sans-serif; margin: 0; background: #f4f4f4; }
header, footer { background: #0d233a; color: white; padding: 15px; text-align: center; }
nav ul { list-style: none; padding: 0; display: flex; justify-content: center; gap: 15px; }
nav a { color: white; text-decoration: none; font-weight: bold; }
main { max-width: 900px; margin: 20px auto; padding: 20px; background: white; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
.card { border: 1px solid #ddd; padding: 15px; border-radius: 5px; }
.error { color: red; display: none; font-size: 12px; }